# Copy to .env.local for local use; set the real values in Vercel → Settings → Environment Variables.

# Umami Cloud website ID (Umami → Settings → Websites → Edit → Website ID).
# Link-click analytics are off when this is unset.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# Optional: comma-separated hostnames Umami should count. Defaults to the
# production host from src/content/site.ts (bhavinmistry.club), so previews and
# localhost are never tracked.
# NEXT_PUBLIC_UMAMI_DOMAINS=bhavinmistry.club
